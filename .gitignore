__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

# ---------------------------------------------------------------------------
# Données : jamais versionnées.
#
# Les documents juridiques traités et les sorties du pipeline restent locaux.
# La ligne `!<dossier>/**/` est indispensable : sans elle, Git ne redescend pas
# dans un dossier exclu et les `.gitkeep` seraient perdus avec le reste.
# ---------------------------------------------------------------------------
input/**
!input/**/
!input/**/.gitkeep

data/**
!data/**/
!data/**/.gitkeep

logs/*
!logs/.gitkeep

# Configuration propre à la machine
config/local.yaml

# Outils
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Dossiers de travail d'un lot : lot1/, lot2/, lot2local/...
# Ils contiennent le corpus reel — bases SQLite de plusieurs dizaines de Mo,
# JSONL d'articles, et surtout les PDF OCRises des documents eux-memes.
# Aucun document juridique reel ne doit entrer dans le depot (regle fondatrice).
# Le motif « data/** » ne les couvrait pas : ces dossiers sont ailleurs.
lot*/
